# 서버 포트 (Cloudtype은 PORT를 주입함)
PORT=18070

# CORS 허용 오리진 (프론트 주소)
CORS_ORIGIN=http://localhost:16000

# PostgreSQL 연결 (Supabase, Prisma)
# Supabase 대시보드 → Project Settings → Database → Connection string 에서 확인.
# 앱 런타임(드라이버 어댑터 @prisma/adapter-pg)은 Transaction pooler(포트 6543) 권장.
# 예: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# prisma migrate 는 direct connection(포트 5432) 필요 — pooler 로는 마이그레이션 불가.
# 예: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 토스증권 오픈 API
TOSS_API_BASE_URL=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=180d

# 프론트(App) 주소 — 카카오 콜백 후 세션 라우트로 리다이렉트할 대상
CLIENT_URL=http://localhost:16000

# Kakao OAuth (baby-rang 과 동일 앱 키 공유 — 실제 값은 .env 에 설정)
# ⚠️ Kakao Developers 콘솔에 아래 callback URL(Redirect URI)을 반드시 등록해야 함
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_ADMIN_KEY=your-kakao-admin-key
KAKAO_CALLBACK_URL=http://localhost:18070/api/auth/kakao/callback
