// Stock Guard — Prisma schema
// 형상관리: prisma migrate dev/deploy 로 마이그레이션 이력을 git에 커밋

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── 공통 필드(=Base Entity) 규약 ─────────────────────────────
// Prisma 는 모델 상속이 없어 아래 4개 공통 필드를 "모든 모델"에 동일하게 포함한다.
// (실코드에선 src/common/base.ts 의 genId 로 id 를 채우고, Prisma Client 확장이
//  create/upsert 시 자동 주입하므로 서비스 코드에서 id 를 신경 쓸 필요는 없다.)
//
//   id        String   @id @default(cuid()) @db.Char(32)        // 32자 id. 런타임은 확장이 genId(32자 hex)로 채우고,
//                                                              //  @default(cuid())는 create 입력에서 id를 optional로 만들기 위한 것(폴백)
//   idx       Int      @unique @default(autoincrement())        // 내부 순번 (정렬/클러스터링용)
//   createdAt DateTime @default(now())  @map("created_at")
//   updatedAt DateTime @updatedAt       @map("updated_at")
//
// 새 모델을 추가할 때는 위 블록을 그대로 복사해 넣을 것.
// ─────────────────────────────────────────────────────────────

enum AuthProvider {
  KAKAO
  GOOGLE
  NAVER
  APPLE
}

model User {
  // ── Base ──
  id        String   @id @default(cuid()) @db.Char(32)
  idx       Int      @unique @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // ──────────

  email        String? @unique
  nickname     String?
  profileImage String? @map("profile_image")

  // 소셜 로그인 연결 (1:N) — 한 유저가 여러 provider 를 가질 수 있음.
  accounts          Account[]
  // 연결된 증권 계좌 (본인/가족 등)
  brokerageAccounts BrokerageAccount[]

  @@map("users")
}

// 소셜 로그인 연결 — 한 user 가 여러 provider 를 가질 수 있도록 분리.
// (provider, providerId)는 SNS 측 식별자로 글로벌 유니크.
model Account {
  // ── Base ──
  id        String   @id @default(cuid()) @db.Char(32)
  idx       Int      @unique @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // ──────────

  userId     String       @map("user_id") @db.Char(32)
  provider   AuthProvider
  providerId String       @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("accounts")
}

// 연결된 증권 계좌 (본인/가족 등). 기존 스켈레톤의 Account 를 OAuth 용 Account 와
// 이름이 겹치지 않도록 BrokerageAccount 로 분리.
model BrokerageAccount {
  // ── Base ──
  id        String   @id @default(cuid()) @db.Char(32)
  idx       Int      @unique @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // ──────────

  userId    String  @map("user_id") @db.Char(32)
  broker    String  @default("toss") // 증권사
  nickname  String? // 표시 이름 (예: 아들 계좌)
  ownerType String  @default("self") @map("owner_type") // self | family | other

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("brokerage_accounts")
}
