// Stock Guard — Prisma schema
// 형상관리: prisma migrate dev/deploy 로 마이그레이션 이력을 git에 커밋

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ── 뼈대용 최소 모델 (도메인 설계 시 확장) ──────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
}

// 연결된 증권 계좌 (본인/가족 등)
model Account {
  id           String   @id @default(cuid())
  userId       String
  broker       String   @default("toss") // 증권사
  nickname     String?                    // 표시 이름 (예: 아들 계좌)
  ownerType    String   @default("self")  // self | family | other
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
